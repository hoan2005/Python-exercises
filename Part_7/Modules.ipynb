   "source": [
    "from math import sqrt\n",
    "\n",
    "def hypotenuse(leg1: float, leg2: float):\n",
    "    return sqrt(leg1**2 + leg2**2)\n",
    "\n",
    "\n",
    "print(hypotenuse(3, 4))   # 5.0\n",
    "print(hypotenuse(5, 12))  # 13.0\n",
    "print(hypotenuse(1, 1))   # 1.4142135623730951"
   ]
  }
 ],
